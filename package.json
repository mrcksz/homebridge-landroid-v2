    "landroid",
    "kress",
    "landxcape",
    "ferrex",
    "mower",
    "lawn-mower",
    "robot-mower"
  ],
  "author": "Foxlution IT (v2 fork), originally Normen Hansen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mrcksz/homebridge-landroid-v2/issues"
  },
  "homepage": "https://github.com/mrcksz/homebridge-landroid-v2#readme",
  "files": [
    "index.js",
    "CloudConnector.js",
    "CloudAdapter.js",
